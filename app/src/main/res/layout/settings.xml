<?xml version="1.0" encoding="utf-8"?>
<!--
    SETTINGS ACTIVITY LAYOUT
    File: res/layout/activity_settings.xml
    Used by: SettingsActivity.java
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Section: Profile -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROFILE"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">

                <include layout="@layout/item_settings_row"
                    android:id="@+id/row_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/bg_elevated" android:layout_marginStart="16dp" />
                <include layout="@layout/item_settings_row"
                    android:id="@+id/row_weight_unit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/bg_elevated" android:layout_marginStart="16dp" />
                <include layout="@layout/item_settings_row"
                    android:id="@+id/row_goal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <!-- Section: App -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APP"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">

                <include layout="@layout/item_settings_row"
                    android:id="@+id/row_notifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/bg_elevated" android:layout_marginStart="16dp" />
                <include layout="@layout/item_settings_row"
                    android:id="@+id/row_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/bg_elevated" android:layout_marginStart="16dp" />
                <include layout="@layout/item_settings_row"
                    android:id="@+id/row_rest_timer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <!-- Logout -->
            <Button
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Log Out"
                android:textColor="#EF4444"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_card_rounded"
                android:stateListAnimator="@null"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="24dp" />

            <!-- Version -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GymBro v1.0.0"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_gravity="center"
                android:layout_marginTop="16dp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>