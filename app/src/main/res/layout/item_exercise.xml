<?xml version="1.0" encoding="utf-8"?>
<!--
    EXERCISE LIST ITEM
    File: res/layout/item_exercise.xml
    Used by: ExerciseAdapter.java
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Exercise Icon / Muscle Color Indicator -->
        <View
            android:id="@+id/view_muscle_indicator"
            android:layout_width="4dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_avatar"
            android:layout_marginEnd="14dp" />

        <!-- Exercise Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Exercise Name -->
            <TextView
                android:id="@+id/tv_exercise_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barbell Bench Press"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Muscle Group Tag + Equipment -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="5dp">

                <!-- Muscle group pill -->
                <TextView
                    android:id="@+id/tv_muscle_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chest"
                    android:textColor="@color/primary_light"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_muscle_tag"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />

                <!-- Dot separator -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="#6B7280"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

                <!-- Equipment -->
                <TextView
                    android:id="@+id/tv_equipment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Barbell"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Difficulty badge -->
        <TextView
            android:id="@+id/tv_difficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inter"
            android:textColor="@color/warning"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>