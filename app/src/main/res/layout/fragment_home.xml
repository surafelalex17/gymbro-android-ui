<?xml version="1.0" encoding="utf-8"?>
<!--
    HOME FRAGMENT LAYOUT
    File: res/layout/fragment_home.xml
    Used by: HomeFragment.java
    Shows: greeting, weekly streak, weekly goal, stats grid
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- ====== HEADER ====== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="52dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good morning 👋"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alex"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Avatar Circle -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_avatar" />

                <TextView
                    android:id="@+id/tv_avatar_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="A"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center" />

            </FrameLayout>

        </LinearLayout>

        <!-- ====== STREAK CARD (Full Width) ====== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_streak_card"
            android:padding="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp">

            <!-- Title Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_fire"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WEEKLY STREAK"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tv_streak_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 days"
                    android:textColor="@color/streak_orange"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Day dots row -->
            <LinearLayout
                android:id="@+id/streak_dots_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <!-- Day dots are added programmatically in HomeFragment -->
                <!-- Mon -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <View android:id="@+id/dot_mon"
                        android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_day_dot_active" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="M" android:textColor="@color/text_muted" android:textSize="10sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Tue -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <View android:id="@+id/dot_tue"
                        android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_day_dot_active" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="T" android:textColor="@color/text_muted" android:textSize="10sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Wed -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <View android:id="@+id/dot_wed"
                        android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_day_dot_active" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="W" android:textColor="@color/text_muted" android:textSize="10sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Thu -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <View android:id="@+id/dot_thu"
                        android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_day_dot_active" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="T" android:textColor="@color/text_muted" android:textSize="10sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Fri -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <View android:id="@+id/dot_fri"
                        android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_day_dot_active" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="F" android:textColor="@color/text_muted" android:textSize="10sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Sat -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <View android:id="@+id/dot_sat"
                        android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_day_dot_inactive" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="S" android:textColor="@color/text_muted" android:textSize="10sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Sun -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <View android:id="@+id/dot_sun"
                        android:layout_width="32dp" android:layout_height="32dp"
                        android:background="@drawable/bg_day_dot_inactive" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="S" android:textColor="@color/text_muted" android:textSize="10sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ====== WEEKLY GOAL CARD ====== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_goal_card"
            android:padding="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp">

            <!-- Header row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WEEKLY GOAL"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tv_goal_ratio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 / 5 workouts"
                    android:textColor="@color/primary_light"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Progress bar -->
            <ProgressBar
                android:id="@+id/progress_weekly_goal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressDrawable="@drawable/bg_progress_track"
                android:max="5"
                android:progress="5" />

            <TextView
                android:id="@+id/tv_goal_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 Weekly goal smashed!"
                android:textColor="@color/success"
                android:textSize="12sp"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- ====== SECTION LABEL ====== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THIS WEEK"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:textAllCaps="true"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="12dp" />

        <!-- ====== STATS GRID (2 columns) ====== -->
        <!-- Row 1: Workouts + Duration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp">

            <!-- Workouts Completed Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_card"
                android:padding="16dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WORKOUTS"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tv_workouts_completed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textColor="@color/text_primary"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="completed"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Total Duration Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_stat_card"
                android:padding="16dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DURATION"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tv_total_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4h 20m"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="total this week"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Row 2: Total Volume (full width) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_stat_card"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL VOLUME"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"

                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tv_total_volume"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="48,250"
                        android:textColor="@color/primary_light"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" kg"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp"
                        android:layout_marginBottom="6dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="weight lifted this week"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Up arrow trend -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↑ 12%"
                android:textColor="@color/success"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ====== START WORKOUT BUTTON ====== -->
<!--        <Button-->
<!--            android:id="@+id/btn_start_workout"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="56dp"-->
<!--            android:text="⚡  Start Workout"-->
<!--            android:textColor="@color/text_primary"-->
<!--            android:textSize="17sp"-->
<!--            android:textStyle="bold"-->
<!--            android:background="@drawable/bg_primary_button"-->
<!--            android:stateListAnimator="@null"-->
<!--            android:layout_marginStart="20dp"-->
<!--            android:layout_marginEnd="20dp" />-->

    </LinearLayout>

</ScrollView>