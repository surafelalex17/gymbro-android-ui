<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GymbroMAD">

        <!-- Splash is the true launcher -->
        <activity
            android:name="com.gymbro.app.activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.gymbro.app.activities.LoginActivity"
            android:exported="false" />

        <activity
            android:name="com.gymbro.app.activities.RegisterActivity" />

        <activity
            android:name="com.gymbro.app.activities.MainActivity"
            android:exported="false" />

        <activity
            android:name="com.gymbro.app.activities.SettingsActivity" />

        <activity
            android:name="com.gymbro.app.activities.WorkoutSessionActivity" />

        <activity
            android:name="com.gymbro.app.activities.ExercisePickerActivity" />

        <activity
            android:name="com.gymbro.app.activities.RoutineDetailActivity" />

    </application>

</manifest>